# Turn on the rewrite engine
RewriteEngine On

# 1. Stop processing if the request is for an actual physical file (like image.png, style.css)
RewriteCond %{REQUEST_FILENAME} !-f

# 2. Stop processing if the request is for an actual physical directory
RewriteCond %{REQUEST_FILENAME} !-d

# 3. Route everything else to index.php
RewriteRule ^ index.php [QSA,L]
